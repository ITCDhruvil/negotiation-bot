COMPANY_NAME=SKODA
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# If 8000 is already taken by another service, set BACKEND_PORT=8001
# and BACKEND_INTERNAL_URL=http://127.0.0.1:8001 (do not kill the other process).
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
# auto picks openai, then anthropic, then azure when credentials exist.
# mock is for automated tests only (ARIA_ALLOW_MOCK=1). Live sessions ignore mock if a key is set.
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_REASONING_MODEL=o4-mini
OPENAI_REASONING_EFFORT=medium
# Fine-tune gpt-4o-mini from closed desks. o4-mini cannot be fine-tuned.
# 10 is OpenAI's floor. 20 starts a job. 50–100+ is the first useful voice lift.
# Dashboard /ops/finetune can override these without editing .env.
OPENAI_FINETUNE_AUTO=true
OPENAI_FINETUNE_BASE=gpt-4o-mini
OPENAI_FINETUNE_MIN_EXAMPLES=20
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
DATABASE_URL=postgresql://negotiator:negotiator@localhost:5432/negotiation
REDIS_URL=redis://localhost:6379/0
USE_IN_MEMORY=false
CORS_ORIGINS=http://localhost:3000
HANDOFF_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
SENDGRID_API_KEY=
NOTIFY_EMAIL_FROM=aria@skoda.example
NOTIFY_EMAIL_TO=
NEXT_PUBLIC_API_URL=
